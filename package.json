{
	"type": "module",
	"name": "underwriter",
	"version": "1.0.2",
	"description": "An automated Promise Registry",
	"author": "Joseph Dalrymple <swivelgames@gmail.com>",
	"main": "lib/index.mjs",
	"browser": "lib/index.cjs",
	"typings": "index.d.ts",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"files": [
		"lib/",
		"index.d.ts",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm run build:rollup",
		"build:rollup": "rollup --config rollup.config.js",
		"clean": "rm -rf lib",
		"watch": "pnpm run build:rollup -- --watch",
		"start": "pnpm run watch",
		"test": "pnpm run test-eslint && pnpm run coverage",
		"test-md": "markdownlint --fix ./README.md",
		"test-eslint": "eslint --fix ./src/**/*.js",
		"test-mocha": "mocha --config ./.mocharc.jsonc",
		"test-mocha:watch": "mocha --config ./.mocharc.jsonc --watch",
		"coverage": "c8 --check-coverage pnpm run test-mocha"
	},
	"devDependencies": {
		"@babel/cli": "^7.29.7",
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/register": "^7.29.7",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@rollup/plugin-babel": "^7.1.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.13.5",
		"@types/sinon": "^22.0.0",
		"c8": "^12.0.0",
		"eslint": "^9.39.5",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.12.0",
		"markdownlint-cli": "^0.49.1",
		"mocha": "^12.0.2",
		"rollup": "^4.63.3",
		"sinon": "^22.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"underwriter": "link:."
	},
	"keywords": [
		"promise",
		"registry",
		"guarantee",
		"guarantor",
		"warranty",
		"warrantor",
		"fulfill",
		"reject",
		"dependency",
		"injection"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Swivelgames/underwriter.git"
	},
	"bugs": {
		"url": "https://github.com/Swivelgames/underwriter/issues"
	},
	"homepage": "https://github.com/Swivelgames/underwriter#readme",
	"license": "MIT OR GPL-3.0-only"
}
