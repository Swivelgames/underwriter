{
	"compilerOptions": {
		"target": "es2016",

		"module": "nodenext",
		"paths": {
			"underwriter": ["./index.js"]
		},
		"typeRoots": ["./types", "./node_modules/@types"],
		"types": ["node", "mocha", "sinon"],

		"allowJs": true,

		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		"strict": true,

		"skipDefaultLibCheck": false,
		"skipLibCheck": false
	},
	"include": ["src/**/*.ts", "index.d.ts"]
}
